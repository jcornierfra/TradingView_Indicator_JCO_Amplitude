// © jcornier
//
// Version: 2.2.0 (port Pine du Tradovate Indicator_JCO_Amplitude v2.1.3)
// GitHub:  https://github.com/jcornierfra/TradingView_Indicator_JCO_Amplitude
//
// Description: Port TradingView de l'indicateur d'amplitude Tradovate.
//              Force la timeframe M1 quelle que soit la TF du chart via
//              request.security_lower_tf(). Permet d'utiliser le chart en
//              M5 / M15 / H1 etc. pour le contexte, tout en gardant des
//              marques posees aux instants et prix exacts du declenchement
//              M1. Si la TF du chart est < M1 (sub-minute), on retombe sur
//              la TF du chart (impossible de descendre dessous).
//
//              Mecanique a deux phases (identique a la version JS) :
//
//                Phase 1 (searching) - 1ere marque du jour
//                  Detection du dernier swing valide (leftBars/rightBars,
//                  extrema stricts). Depuis le swing, on attend qu'amp1
//                  soit atteint dans le sens oppose. Marque posee au prix
//                  exact swing.price +/- amp1 -> passage en phase 2.
//
//                Phase 2 (tracking) - cycle apres la 1ere marque
//                  Etat (pour direction 'up' ; symetrique en down) :
//                    - origin       : ancre du calcul des 30%
//                    - refExtreme   : plus haut atteint depuis la marque
//                    - oppExtreme   : plus bas atteint depuis la marque
//                                     (monotone, sert au continuation)
//                    - localOpp     : plus bas depuis dernier reset de
//                                     refExtreme (sert au reversal)
//                    - recoveryExt  : plus haut depuis dernier reset
//                                     d'oppExtreme
//                    - currentPath  : 'amp1' | 'amp2', sticky, fige sur
//                                     baisse d'oppExtreme
//                    - retracementSeen : true des qu'oppExt a strictement
//                                        bouge
//
//                  Path : reevalue UNIQUEMENT quand oppExtreme baisse.
//                    retrace > 30% * (refExt - origin) -> amp1, sinon amp2
//
//                  Deux regles (par priorite) :
//                    1. Reversal (seuil amp1 toujours, si retracementSeen):
//                         localRetrace = refExt - localOpp >= amp1
//                       -> marque amp1, couleur opposee, direction inversee
//                    2. Continuation (path-driven):
//                         recovery = recoveryExt - oppExt >= amp_path
//                       -> marque amp_path, meme couleur
//
//              Code couleur (lecture contrarienne) :
//                - Mouvement BAS -> HAUT  -> marque ROUGE (signal vente)
//                - Mouvement HAUT -> BAS  -> marque VERTE (signal achat)
//
//              Fenetre d'affichage [start - end] h:min (defaut 08h00-22h00
//              Europe/Paris). Reset journalier a minuit Paris.
//
// Changelog:
//   v2.2.0 - 2026-05-17
//     - Force la timeframe M1 via request.security_lower_tf() quelle que
//       soit la TF du chart. Permet d'utiliser un chart M5 / M15 / H1 pour
//       le contexte tout en gardant la finesse de declenchement M1.
//     - Etat encapsule dans un type 'State' mutable (pour permettre la
//       mutation depuis la fonction de traitement par bougie M1).
//     - Historique des bougies M1 maintenu dans des arrays locaux pour
//       la detection de swing (les offsets [i] ne sont plus pertinents
//       avec l'iteration par bougie M1).
//     - Marker width reste base sur la TF du chart (pour rester visible
//       quand on est sur une TF > M1).
//     - Limitation : sur une TF chart > M1, les marques apparaissent
//       au timestamp M1, donc au milieu des bougies du chart. C'est
//       visuellement attendu.
//
//   v2.1.3 - 2026-05-17
//     - Release initiale (port de la version Tradovate v2.1.3).
//     - Detection swing native (leftBars/rightBars) sur la TF du chart.
//     - Machine d'etats deux phases (searching, tracking).
//     - Reset journalier Europe/Paris, fenetre horaire h+min.
//     - Rendu via line.new (trait horizontal au prix de declenchement).

//@version=6
indicator("JCO Amplitude", "JCO Amplitude", overlay=true, max_lines_count=500)

// === Inputs ===
amp1Pts         = input.float(80,   "Amp1 (1ere / reversal)",         minval=1,    group="Amplitudes")
amp2Pts         = input.float(60,   "Amp2 (continuation)",            minval=1,    group="Amplitudes")
pointSize       = input.float(1.0,  "Prix par point (NQ/MNQ/ES = 1)", minval=0.01, step=0.05, group="Amplitudes")

leftBars        = input.int(1,      "Swing left bars",                minval=1, maxval=20, group="Swing")
rightBars       = input.int(1,      "Swing right bars",               minval=1, maxval=20, group="Swing")

startHour       = input.int(8,      "Debut (Paris) h",                minval=0, maxval=23, group="Fenetre", inline="start")
startMinute     = input.int(0,      "min",                            minval=0, maxval=59, group="Fenetre", inline="start")
endHour         = input.int(22,     "Fin   (Paris) h",                minval=0, maxval=24, group="Fenetre", inline="end")
endMinute       = input.int(0,      "min",                            minval=0, maxval=59, group="Fenetre", inline="end")

markerWidthBars = input.float(1.4,  "Largeur marque (bars)",          minval=0.5, step=0.1, group="Affichage")
lineWidth       = input.int(2,      "Epaisseur trait",                minval=1, maxval=10, group="Affichage")
bullColor       = input.color(color.new(#00C853, 10), "Couleur haussiere (signal achat)",   group="Affichage")
bearColor       = input.color(color.new(#FF1744, 10), "Couleur baissiere (signal vente)",   group="Affichage")

// === Type Etat (encapsule pour permettre la mutation depuis une fonction) ===
type State
    string phase           // "searching" | "tracking"
    string direction       // "up" (mvt haussier, marque rouge) | "down"
    float  activeAmpPts
    float  origin
    float  refExtreme
    float  oppExtreme
    float  localOpp
    float  recoveryExt
    bool   retracementSeen
    string currentPath     // "amp1" | "amp2"
    float  swingPrice
    int    swingTime
    string swingType       // "low" | "high"
    int    lastDayKey      // sentinel pour le reset journalier

var State s = State.new(phase           = "searching",
                         direction       = na,
                         activeAmpPts    = na,
                         origin          = na,
                         refExtreme      = na,
                         oppExtreme      = na,
                         localOpp        = na,
                         recoveryExt     = na,
                         retracementSeen = false,
                         currentPath     = "amp2",
                         swingPrice      = na,
                         swingTime       = na,
                         swingType       = na,
                         lastDayKey      = 0)

// === Historique des bougies M1 (buffer local pour la detection swing) ===
var array<float> hist_h = array.new<float>()
var array<float> hist_l = array.new<float>()
var array<int>   hist_t = array.new<int>()
const int MAX_HIST = 200

// === Helper de dessin ===
// Trait horizontal au prix de declenchement, centre sur le timestamp M1.
// La largeur du trait reste basee sur la TF du chart (pour rester visible
// quand on est sur une TF > M1).
f_drawMarker(triggerPrice, useBearColor, t) =>
    tfSec = timeframe.in_seconds(timeframe.period)
    tfMs = (tfSec > 0 ? tfSec : 60) * 1000
    halfW = int(math.round(tfMs * markerWidthBars / 2.0))
    col = useBearColor ? bearColor : bullColor
    line.new(x1=t - halfW, y1=triggerPrice, x2=t + halfW, y2=triggerPrice,
             xloc=xloc.bar_time, color=col, width=lineWidth)

// === Traitement d'une bougie M1 ===
// Pousse h/l/t dans le buffer, applique reset journalier, detection swing,
// puis les regles d'amplitude.
f_processBar(float h, float l, int t) =>
    // 1) Push history + trim
    array.push(hist_h, h)
    array.push(hist_l, l)
    array.push(hist_t, t)
    if array.size(hist_h) > MAX_HIST
        array.shift(hist_h)
        array.shift(hist_l)
        array.shift(hist_t)

    // 2) Reset journalier (minuit Europe/Paris) base sur le timestamp M1
    int dk = year(t, "Europe/Paris") * 10000 + month(t, "Europe/Paris") * 100 + dayofmonth(t, "Europe/Paris")
    if s.lastDayKey != 0 and dk != s.lastDayKey
        s.phase           := "searching"
        s.direction       := na
        s.activeAmpPts    := na
        s.origin          := na
        s.refExtreme      := na
        s.oppExtreme      := na
        s.localOpp        := na
        s.recoveryExt     := na
        s.retracementSeen := false
        s.currentPath     := "amp2"
        s.swingPrice      := na
        s.swingTime       := na
        s.swingType       := na
    s.lastDayKey := dk

    // 3) Detection swing (phase searching uniquement)
    if s.phase == "searching"
        int n = array.size(hist_h)
        if n >= leftBars + rightBars + 1
            int pivotIdx = n - 1 - rightBars
            float pivotHigh = array.get(hist_h, pivotIdx)
            float pivotLow  = array.get(hist_l, pivotIdx)
            bool isSwingLow  = true
            bool isSwingHigh = true
            for k = 1 to leftBars
                if array.get(hist_l, pivotIdx - k) <= pivotLow
                    isSwingLow := false
                if array.get(hist_h, pivotIdx - k) >= pivotHigh
                    isSwingHigh := false
            for k = 1 to rightBars
                if array.get(hist_l, pivotIdx + k) <= pivotLow
                    isSwingLow := false
                if array.get(hist_h, pivotIdx + k) >= pivotHigh
                    isSwingHigh := false
            int pivotTime = array.get(hist_t, pivotIdx)
            if isSwingLow
                if na(s.swingTime) or s.swingTime != pivotTime or s.swingType != "low"
                    s.swingPrice := pivotLow
                    s.swingTime  := pivotTime
                    s.swingType  := "low"
            else if isSwingHigh
                if na(s.swingTime) or s.swingTime != pivotTime or s.swingType != "high"
                    s.swingPrice := pivotHigh
                    s.swingTime  := pivotTime
                    s.swingType  := "high"

    // 4) Fenetre horaire
    int minutesNow = hour(t, "Europe/Paris") * 60 + minute(t, "Europe/Paris")
    int startMins  = startHour * 60 + startMinute
    int endMins    = endHour   * 60 + endMinute
    bool inWindow  = minutesNow >= startMins and minutesNow < endMins

    if inWindow
        float amp1Price = amp1Pts * pointSize
        float amp2Price = amp2Pts * pointSize

        // -------- Phase 1 : searching --------
        if s.phase == "searching" and not na(s.swingPrice)
            if s.swingType == "low"
                float triggerPrice = s.swingPrice + amp1Price
                if h >= triggerPrice
                    f_drawMarker(triggerPrice, true, t)
                    s.phase           := "tracking"
                    s.direction       := "up"
                    s.origin          := s.swingPrice
                    s.activeAmpPts    := amp1Pts
                    s.refExtreme      := triggerPrice
                    s.oppExtreme      := triggerPrice
                    s.localOpp        := triggerPrice
                    s.recoveryExt     := triggerPrice
                    s.retracementSeen := false
                    s.currentPath     := "amp2"
            else if s.swingType == "high"
                float triggerPrice = s.swingPrice - amp1Price
                if l <= triggerPrice
                    f_drawMarker(triggerPrice, false, t)
                    s.phase           := "tracking"
                    s.direction       := "down"
                    s.origin          := s.swingPrice
                    s.activeAmpPts    := amp1Pts
                    s.refExtreme      := triggerPrice
                    s.oppExtreme      := triggerPrice
                    s.localOpp        := triggerPrice
                    s.recoveryExt     := triggerPrice
                    s.retracementSeen := false
                    s.currentPath     := "amp2"
        // -------- Phase 2 : tracking --------
        else if s.phase == "tracking"
            // 1) Mise a jour des extremes
            bool oppDropped = false
            if s.direction == "up"
                if h > s.refExtreme
                    s.refExtreme := h
                    s.localOpp   := s.refExtreme
                if l < s.localOpp
                    s.localOpp := l
                if l < s.oppExtreme
                    s.oppExtreme      := l
                    s.recoveryExt     := l
                    s.retracementSeen := true
                    oppDropped        := true
                if h > s.recoveryExt
                    s.recoveryExt := h
            else
                if l < s.refExtreme
                    s.refExtreme := l
                    s.localOpp   := s.refExtreme
                if h > s.localOpp
                    s.localOpp := h
                if h > s.oppExtreme
                    s.oppExtreme      := h
                    s.recoveryExt     := h
                    s.retracementSeen := true
                    oppDropped        := true
                if l < s.recoveryExt
                    s.recoveryExt := l

            // 2) Distances signees
            float retrace      = s.direction == "up" ? s.refExtreme  - s.oppExtreme  : s.oppExtreme - s.refExtreme
            float localRetrace = s.direction == "up" ? s.refExtreme  - s.localOpp    : s.localOpp   - s.refExtreme
            float recovery     = s.direction == "up" ? s.recoveryExt - s.oppExtreme  : s.oppExtreme - s.recoveryExt
            float totalMove    = s.direction == "up" ? s.refExtreme  - s.origin      : s.origin     - s.refExtreme

            // 3) Re-evaluation du path uniquement sur baisse d'oppExtreme
            if oppDropped
                s.currentPath := retrace > 0.30 * totalMove ? "amp1" : "amp2"

            // 4) Regles par priorite
            bool markPlaced = false

            // Regle 1 : Reversal (seuil = amp1 TOUJOURS, requiert un vrai retracement)
            if s.retracementSeen and localRetrace >= amp1Price
                float revTrigger = s.direction == "up" ? s.refExtreme - amp1Price : s.refExtreme + amp1Price
                string newDirection = s.direction == "up" ? "down" : "up"
                bool useBearColor = newDirection == "up"
                f_drawMarker(revTrigger, useBearColor, t)
                s.direction       := newDirection
                s.origin          := s.refExtreme
                s.activeAmpPts    := amp1Pts
                s.refExtreme      := revTrigger
                s.oppExtreme      := revTrigger
                s.localOpp        := revTrigger
                s.recoveryExt     := revTrigger
                s.retracementSeen := false
                s.currentPath     := "amp2"
                markPlaced        := true

            // Regle 2 : Continuation (path-driven : amp1 ou amp2 selon currentPath)
            if not markPlaced
                float ampPathPrice = s.currentPath == "amp1" ? amp1Price : amp2Price
                float ampPathPts   = s.currentPath == "amp1" ? amp1Pts   : amp2Pts
                if recovery >= ampPathPrice
                    float contTrigger = s.direction == "up" ? s.oppExtreme + ampPathPrice : s.oppExtreme - ampPathPrice
                    bool useBearColor = s.direction == "up"
                    f_drawMarker(contTrigger, useBearColor, t)
                    s.origin          := s.oppExtreme
                    s.activeAmpPts    := ampPathPts
                    s.refExtreme      := contTrigger
                    s.oppExtreme      := contTrigger
                    s.localOpp        := contTrigger
                    s.recoveryExt     := contTrigger
                    s.retracementSeen := false
                    s.currentPath     := "amp2"

// === Entry point ===
// Force M1 quelle que soit la TF du chart. Si chart < M1 (sub-minute), on
// retombe sur la TF du chart (impossible de descendre dessous).
string forcedTf = timeframe.in_seconds(timeframe.period) >= 60 ? "1" : timeframe.period
[m1_h_arr, m1_l_arr, m1_t_arr] = request.security_lower_tf(syminfo.tickerid, forcedTf, [high, low, time])

if not na(m1_h_arr)
    int n = array.size(m1_h_arr)
    if n > 0
        for i = 0 to n - 1
            f_processBar(array.get(m1_h_arr, i), array.get(m1_l_arr, i), array.get(m1_t_arr, i))
